DISCORD_TOKEN=your_bot_token_here
PREFIX=!

# Web dashboard port
PORT=3000

# Secret key for dashboard edits (add/remove via web). Leave empty to disable web edits.
DASHBOARD_KEY=change_this_secret

# ---- Dashboard login (all pages except / need login when set) ----
ADMIN_USER=admin
ADMIN_PASS=change_this_password
# Optional session sign key (falls back to DASHBOARD_KEY/ADMIN_PASS)
# SESSION_SECRET=long_random_string

# ---- Discord OAuth login (Login with Discord button on /login) ----
# Portal -> OAuth2 -> Redirects must include: http://localhost:3000/api/discord-callback
# (use your DASHBOARD_URL + /api/discord-callback if hosted on a domain)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ADMIN_DISCORD_IDS= (optional: comma user IDs allowed even without a managed server)

# ---- AI Connect ----
# REQUIRE_JOIN_CODE=true -> nobody can use free AI without unlocking first
# (dashboard Codes page -> /join <code>, or !!connect auth <CODE>).
# Custom server keys and logged-in OAuth users are not affected.
REQUIRE_JOIN_CODE=true
# Optional: single shared code as an alternative unlock ("!!connect auth <CODE>").
# Leave empty for dashboard-codes-only. Example: AI_AUTH_CODE=mysecret123
AI_AUTH_CODE=

# Optional defaults for custom AI (per-server !!connect api overrides this).
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ---- Google keyless login for Gemini (one-time owner setup) ----
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web app).
# Authorized redirect URI must be: <DASHBOARD_URL>/api/oauth-callback
# Enable "Generative Language API", add test users while in Testing mode.
# Users then run "!!connect login google" — no key paste needed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Dashboard "Continue with Google": only these emails may log in.
# GOOGLE_ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# ---- Hugging Face keyless login (one-time owner setup) ----
# Create a PUBLIC OAuth app (scope: inference-api) at
# https://huggingface.co/settings/applications/new, then set its client ID here.
# Users can then run "!!connect login huggingface" — no key paste needed.
# HF_CLIENT_ID=
# HF_CLIENT_SECRET= (only if the app has a secret; public apps leave empty)
